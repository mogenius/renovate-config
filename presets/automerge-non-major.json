{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Automerge all non-major updates",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "addLabels": [
        "automerge"
      ]
    }
  ]
}
